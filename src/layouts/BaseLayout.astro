---
import "../styles/global.css"
import '@fontsource-variable/outfit/index.css'
import '@fontsource-variable/ibm-plex-sans/index.css'

import { BaseHead, Nav } from '../components/ui'
import { ClientRouter } from 'astro:transitions'
import type { ImageMetadata } from "astro"

interface Props {
  title?: string
  description?: string
  image: ImageMetadata
  ogType?: string
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const {
  title = 'Portfolio',
  description = 'My personal portfolio',
  image,
  ogType,
  jsonLd
} = Astro.props

---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} jsonLd={jsonLd} />
    <ClientRouter />
  </head>
  <body class="bg-base text-ink antialiased">
    <Nav />
    <main style="padding-top: var(--nav-height);">
      <slot />
    </main>
  </body>
</html>
