---
import "../styles/global.css"
import '@fontsource-variable/outfit/index.css'
import '@fontsource-variable/ibm-plex-sans/index.css'

import { ClientRouter } from "astro:transitions";
import { BaseHead, Footer, Nav } from "../components/ui";

interface Props {
	title: string
	description: string
	robots?: string
	jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null
}

const defaultJsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": "https://chencho-dev.vercel.app/#website",
			"url": "https://chencho-dev.vercel.app/",
			"name": "Armando Crescencio Portfolio",
			"description": "Ingeniero Informático y Full Stack Developer. Especializado en React, Node.js y TypeScript. Basado en México, disponible remotamente.",
			"inLanguage": "es-MX",
			"publisher": {
				"@id": "https://chencho-dev.vercel.app/#person"
			}
		},
		{
			"@type": "Person",
			"@id": "https://chencho-dev.vercel.app/#person",
			"name": "Armando Crescencio",
			"alternateName": "Chencho34",
			"url": "https://chencho-dev.vercel.app/",
			"image": "https://chencho-dev.vercel.app/avatar.webp",
			"jobTitle": "Full Stack Developer",
			"description": "Ingeniero Informático y Full Stack Developer. Especializado en React, Node.js y TypeScript. Basado en México, disponible remotamente. Ve mis proyectos y contáctame.",
			"contactPoint": {
				"@type": "ContactPoint",
				"email": "armandocrescencio343@gmail.com",
				"contactType": "personal"
			},
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Veracruz",
				"addressRegion": "Veracruz",
				"addressCountry": "MX"
			},
			"sameAs": [
				"https://github.com/Chencho34",
				"https://www.linkedin.com/in/armando-cr/"
			],
			"knowsAbout": [
				"React", "Node.js", "TypeScript", "Next.js",
				"Astro", "TailwindCSS", "PostgreSQL", "Docker"
			]
		}
	]
}

const { title, description, robots, jsonLd = defaultJsonLd } = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead 	
			title={title} 
			description={description}
			robots={robots}
			ogType="website"
			jsonLd={jsonLd ?? undefined}
		/>
		<ClientRouter />
	</head>
	<body>
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('a[href^="/#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        const hash = anchor.getAttribute('href')?.split('/')[1]
        const target = document.querySelector(hash ?? '')
        if (target) {
          e.preventDefault()
          target.scrollIntoView({ behavior: 'smooth' })
        }
      })
    })
  })
</script>
